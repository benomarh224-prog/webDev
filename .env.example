# Copy to .env and set your own values before running the app.
DATABASE_URL="file:./dev.db"
# Generate a random secret with at least 32 characters.
AUTH_SECRET=
# Set these before running prisma/seed.ts.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Whole-site gate: base64url-encoded bcrypt hash (never a NEXT_PUBLIC_ variable).
SITE_PASSWORD_HASH=
# Generate a separate random session secret of at least 32 characters.
SITE_SESSION_SECRET=
